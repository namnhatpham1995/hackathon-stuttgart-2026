# Copied to .env by `pnpm dev:setup`, which also fills BETTER_AUTH_SECRET.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/hackathon
# Integration tests drop and recreate this database on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/hackathon_test

# At least 32 characters. Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
PORT=3001

# Optional social sign-in: a provider is enabled only when both of its values are set.
# Google: https://console.cloud.google.com/apis/credentials, redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers, callback URL <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Demo account created by `pnpm db:seed` (local development only).
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo-password-123

# Optional ExportReady features. Leave blank until that feature runs.
# Call requireEnv("NAME") at the point of use; startup stays up when these are empty.
# Gemini: https://aistudio.google.com/apikey — production model is gemini-3.6-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Fact extraction runs on Claude. ANTHROPIC_MODEL defaults to claude-haiku-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Railway origin for the Vercel UI (https://<railway-domain>, no path). Leave blank
# locally and on Railway. When set, next.config.ts proxies /api/* to this origin.
BACKEND_URL=
# Brevo transactional email: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Public origin of this app, with no path. Used in the assessment email link.
APP_BASE_URL=
# Optional spoken replies. Text still works when this is blank.
ELEVENLABS_API_KEY=
