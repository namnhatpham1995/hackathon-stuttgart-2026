{
  "name": "hackathon-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev": "node scripts/next.mjs dev",
    "build": "next build",
    "start": "node scripts/next.mjs start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "worktree": "node scripts/worktree.mjs",
    "memory:install": "node scripts/memory-install.mjs",
    "ux-review:serve": "node scripts/ux-review/serve.mjs",
    "ux-review:secret-check": "node scripts/ux-review/secret-check.mjs",
    "ux-review:stop": "node scripts/ux-review/stop.mjs",
    "prepare": "node scripts/prepare-git-hooks.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.6.0"
}
